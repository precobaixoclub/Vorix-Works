ZUNO_RUNTIME=local
ZUNO_LOG_LEVEL=info
ZUNO_DEFAULT_LOCALE=pt-BR

# Diretórios de dados locais (banco de dados simulado em JSON) e de artefatos gerados.
# Sem essas variáveis, ambos ficam na raiz do projeto (.zuno-data/, artifacts/).
ZUNO_DATA_DIR=
ZUNO_ARTIFACTS_DIR=

# Caminho de um Chromium/Chrome já instalado, usado por Company Intelligence (captura de tela)
# e pelo renderizador de mockup em HTML. Sem essa variável, cada ferramenta resolve seu próprio
# binário (ex.: o Chromium baixado pelo Remotion).
ZUNO_CHROME_PATH=

# "1" ativa logs extras de depuração do Product Compositing (FFmpeg). Nunca usado em produção.
ZUNO_DEBUG_COMPOSITING=

# Allowlist estrita de 2 valores fixos cada — nunca um comando/caminho arbitrário. Ver comentário
# em src/interfaces/cli/run-command.ts (resolveVideoRenderingMode/resolveIcaroMode) antes de mudar.
# ZUNO_VIDEO_RENDER_MODE: "local_render" (padrão) | "developer_assisted"
# ZUNO_ICARO_MODE: "developer_assisted" (padrão) | "fake" (só testes automatizados/demonstrações)
ZUNO_VIDEO_RENDER_MODE=
ZUNO_ICARO_MODE=

# Necessárias apenas para o MetaInstagramSocialPublisherAdapter
# (src/infrastructure/social-networks). Sem essas variáveis não há publicação real possível.
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0

# Necessárias apenas para o Media Intelligence Engine adquirir filmagens reais de um provider
# externo (src/infrastructure/media-providers). Sem essas variáveis, --media-search/--media-acquire*
# mostram a configuração necessária e não executam nenhuma busca/download — a biblioteca local
# continua funcionando normalmente. Chave obtida gratuitamente e instantaneamente em
# https://www.pexels.com/api/ com uma conta Pexels. Nunca commitar o valor real desta chave.
MEDIA_PROVIDER=
MEDIA_PROVIDER_API_KEY=

# ==========================================================================================
# API (Sprint 02 — fundação da plataforma). Lidas por src/interfaces/api/, que hoje só expõe
# um healthcheck. Nenhuma delas habilita autenticação, banco de dados ou billing reais ainda —
# essas fases virão em sprints futuras; estas variáveis só documentam o formato esperado desde já.
# ==========================================================================================

# Porta/host onde a API HTTP escuta quando iniciada (npm run zuno:api). Sem essas variáveis,
# usa 3000 / 0.0.0.0.
API_PORT=
API_HOST=

# Preparado para autenticação futura (Sprint 04) — hoje o middleware de auth só documenta o
# contrato e nunca rejeita uma requisição por falta desta variável. Não gerar/usar em produção
# até a Sprint 04 implementar autenticação de verdade.
JWT_SECRET=

# ==========================================================================================
# Persistência (Sprint 03) — Workspace/Asset Library/Chat. Ver
# src/infrastructure/storage/build-platform-repositories.ts.
# ==========================================================================================

# "memory" (padrão, sem banco nenhum, mesmo comportamento das Sprints 01/02) | "postgres"
# (exige DATABASE_URL). Nunca lido por Skills/Arthur/Caio — só pela raiz de composição da API.
PERSISTENCE_DRIVER=

# Obrigatório quando PERSISTENCE_DRIVER=postgres. String de conexão padrão do driver `pg`
# (ex.: postgres://usuario:senha@host:5432/banco). Rode `npm run db:migrate` antes de subir a
# API pela primeira vez contra um banco novo.
DATABASE_URL=

# "Usuário de desenvolvimento" para o NoopAuthAdapter — sem autenticação real (Sprint 04) ainda,
# mas os endpoints de Workspace exigem um tenantId vindo do contexto de autenticação, nunca do
# corpo da requisição. Defina DEV_PRINCIPAL_TENANT_ID para exercitar esses endpoints localmente;
# sem ela, toda rota que exige tenant responde 401 (comportamento correto e esperado).
DEV_PRINCIPAL_TENANT_ID=
DEV_PRINCIPAL_USER_ID=
