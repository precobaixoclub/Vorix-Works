ZUNO_RUNTIME=local
ZUNO_LOG_LEVEL=info
ZUNO_DEFAULT_LOCALE=pt-BR

# Diretórios de dados locais (banco de dados simulado em JSON) e de artefatos gerados.
# Sem essas variáveis, ambos ficam na raiz do projeto (.zuno-data/, artifacts/).
ZUNO_DATA_DIR=
ZUNO_ARTIFACTS_DIR=

# Caminho de um Chromium/Chrome já instalado, usado por Company Intelligence (captura de tela)
# e pelo renderizador de mockup em HTML. Sem essa variável, cada ferramenta resolve seu próprio
# binário (ex.: o Chromium baixado pelo Remotion).
ZUNO_CHROME_PATH=

# "1" ativa logs extras de depuração do Product Compositing (FFmpeg). Nunca usado em produção.
ZUNO_DEBUG_COMPOSITING=

# Allowlist estrita de 2 valores fixos cada — nunca um comando/caminho arbitrário. Ver comentário
# em src/interfaces/cli/run-command.ts (resolveVideoRenderingMode/resolveIcaroMode) antes de mudar.
# ZUNO_VIDEO_RENDER_MODE: "local_render" (padrão) | "developer_assisted"
# ZUNO_ICARO_MODE: "developer_assisted" (padrão) | "fake" (só testes automatizados/demonstrações)
ZUNO_VIDEO_RENDER_MODE=
ZUNO_ICARO_MODE=

# Necessárias apenas para o MetaInstagramSocialPublisherAdapter
# (src/infrastructure/social-networks). Sem essas variáveis não há publicação real possível.
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0

# Necessárias apenas para o Media Intelligence Engine adquirir filmagens reais de um provider
# externo (src/infrastructure/media-providers). Sem essas variáveis, --media-search/--media-acquire*
# mostram a configuração necessária e não executam nenhuma busca/download — a biblioteca local
# continua funcionando normalmente. Chave obtida gratuitamente e instantaneamente em
# https://www.pexels.com/api/ com uma conta Pexels. Nunca commitar o valor real desta chave.
MEDIA_PROVIDER=
MEDIA_PROVIDER_API_KEY=

# ==========================================================================================
# API (Sprint 02 — fundação da plataforma). Lidas por src/interfaces/api/, que hoje só expõe
# um healthcheck. Nenhuma delas habilita autenticação, banco de dados ou billing reais ainda —
# essas fases virão em sprints futuras; estas variáveis só documentam o formato esperado desde já.
# ==========================================================================================

# Porta/host onde a API HTTP escuta quando iniciada (npm run zuno:api). Sem essas variáveis,
# usa 3000 / 0.0.0.0.
API_PORT=
API_HOST=

# ==========================================================================================
# Identidade e autenticação real (Sprint 05). Ver src/domain/identity/, src/application/identity/,
# src/interfaces/api/routes/v1/auth.route.ts.
# ==========================================================================================

# "jwt" (padrão — autenticação real, exige JWT_SECRET e DATABASE_URL) | "noop" (dev/teste
# explícito, mesmo NoopAuthAdapter das Sprints 02/03, nunca autentica ninguém de verdade).
AUTH_MODE=

# Obrigatório quando AUTH_MODE=jwt (o padrão). Gere um valor aleatório longo — nunca um valor
# previsível. Ex.: `openssl rand -hex 32`. Trocar este valor invalida todos os access tokens
# emitidos (mas não os refresh tokens, que ficam no banco).
JWT_SECRET=

# Duração do access token / refresh token em segundos. Sem essas variáveis: 900 (15 min) / 2592000
# (30 dias).
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=

# "true" adiciona a flag Secure ao cookie do refresh token (exige HTTPS) — use em produção. Sem
# essa variável, cookies funcionam sobre HTTP puro (necessário para localhost em desenvolvimento).
COOKIE_SECURE=

# Domain do cookie de refresh/CSRF. Deixe em branco quando API e frontend respondem no MESMO host
# (cookie host-only, padrão). Configure (ex.: ".exemplo.com") quando API e frontend vivem em
# subdomínios irmãos (api.exemplo.com / exemplo.com) — sem isso o cookie nunca chega ao domínio do
# frontend e o portal de navegação (proxy.ts) manda o usuário de volta para /login mesmo após um
# login bem-sucedido.
COOKIE_DOMAIN=

# Só usados quando AUTH_MODE=noop (ver DEV_PRINCIPAL_TENANT_ID abaixo) — papel do principal fixo
# de desenvolvimento. Sem essa variável: "owner" (acesso total).
DEV_PRINCIPAL_ROLE=

# ==========================================================================================
# Persistência (Sprint 03) — Workspace/Asset Library/Chat. Ver
# src/infrastructure/storage/build-platform-repositories.ts.
# ==========================================================================================

# "memory" (padrão, sem banco nenhum, mesmo comportamento das Sprints 01/02) | "postgres"
# (exige DATABASE_URL). Nunca lido por Skills/Arthur/Caio — só pela raiz de composição da API.
PERSISTENCE_DRIVER=

# Obrigatório quando PERSISTENCE_DRIVER=postgres. String de conexão padrão do driver `pg`
# (ex.: postgres://usuario:senha@host:5432/banco). Rode `npm run db:migrate` antes de subir a
# API pela primeira vez contra um banco novo.
DATABASE_URL=

# "local" (padrão, em memória — só para dev/test/sandbox) | "production" (segredos operacionais,
# incluindo tokens OAuth do TikTok/Meta, gravados cifrados com AES-256-GCM em `operational_secrets`
# via src/infrastructure/operations/postgres-secret-manager.ts). "production" exige
# PERSISTENCE_DRIVER=postgres + DATABASE_URL + JWT_SECRET configurados — sem isso, cai fechado
# (FailClosedProductionSecretManager) e nenhum segredo é lido/gravado.
SECRET_MANAGER_PROVIDER=

# ==========================================================================================
# Execution real controlado (Sprint 12). Por padrão, tudo permanece dry_run. Para permitir modo
# real, habilite a flag global e depois a capability específica.
# ==========================================================================================
REAL_EXECUTION_ENABLED=false
REAL_EXECUTION_RESEARCH_ENABLED=false
REAL_PLANNING_ENABLED=false
REAL_COPY_ENABLED=false
REAL_VISUAL_ENABLED=false
REAL_DISTRIBUTION_ENABLED=false
EXECUTION_ENVIRONMENT=development

# "Usuário de desenvolvimento" para o NoopAuthAdapter — só tem efeito com AUTH_MODE=noop. Defina
# DEV_PRINCIPAL_TENANT_ID para exercitar endpoints localmente sem precisar de login real; sem
# ela, toda rota que exige tenant responde 401 (comportamento correto e esperado).
DEV_PRINCIPAL_TENANT_ID=
DEV_PRINCIPAL_USER_ID=

# ==========================================================================================
# CORS (Sprint 04) — necessário para o frontend web (web/, outra porta) acessar a API do navegador.
# Sem essa variável, o padrão já libera http://localhost:3001 (onde `web/` sobe em dev).
# Aceita uma origem ou uma lista separada por vírgula.
# ==========================================================================================
API_CORS_ORIGIN=

# ==========================================================================================
# Publication provider real em sandbox (Sprint 18). Defaults seguros:
# provider desligado, canário desligado e production bloqueada.
# ==========================================================================================

# "sandbox" (padrão) | "production". Production permanece bloqueada enquanto
# PUBLICATION_PRODUCTION_ENABLED não for explicitamente "true".
PUBLICATION_PROVIDER_ENVIRONMENT=sandbox
PUBLICATION_PRODUCTION_ENABLED=false

# Habilita o adapter Meta Pages Sandbox no registry. LinkedIn/X Sandbox estruturais ficam
# disponíveis como sandbox_only, mas production segue bloqueada.
META_PAGES_SANDBOX_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
META_PAGES_WEBHOOK_SECRET=
LINKEDIN_SANDBOX_WEBHOOK_SECRET=
X_SANDBOX_WEBHOOK_SECRET=

# Canary obrigatório para publicação externa sandbox. Fora desses IDs, pedidos para providers
# externos caem automaticamente para dry_run.
PUBLICATION_CANARY_ENABLED=false
# Providers reais liberados além do canário Meta (CSV). Ex.: tiktok,instagram,facebook
PUBLICATION_CANARY_PROVIDER_IDS=
# Use "*" para liberar todos os tenants/workspaces (multi-cliente em produção).
PUBLICATION_CANARY_TENANT_IDS=
PUBLICATION_CANARY_WORKSPACE_IDS=

# ==========================================================================================
# TikTok Content Posting API. Cada cliente conecta a própria conta via OAuth no painel do
# workspace; o token fica cifrado no secret store e nunca é exposto pela API.
# ==========================================================================================
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Precisa ser idêntica à URL cadastrada no app do TikTok (página de callback do frontend).
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3001/tiktok/callback
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_AUTHORIZE_BASE_URL=https://www.tiktok.com

# ==========================================================================================
# Instagram/Facebook reais (Content Publishing API + Page posts) — mesmo app do Meta usado pelo
# META_PAGES_SANDBOX acima (META_APP_ID/META_APP_SECRET/META_GRAPH_BASE_URL são reaproveitados),
# mas com redirect_uri e produto (Instagram Graph API) próprios cadastrados no app. Cada cliente
# conecta a própria conta via OAuth (PKCE) no painel do workspace; o fluxo resolve todas as Páginas
# do Facebook do usuário e, quando há Instagram profissional vinculado, ambas as credenciais.
# ==========================================================================================
META_INSTAGRAM_ENABLED=false
# Precisa ser idêntica à URL cadastrada no app do Meta (página de callback do frontend).
META_INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3001/instagram/callback

# ==========================================================================================
# Upload de mídia para posts (foto/vídeo enviado pelo cliente, sem precisar já ter uma URL
# pública). Hospeda num bucket compatível com o protocolo S3 — AWS S3, Cloudflare R2,
# DigitalOcean Spaces ou MinIO. Ver docs/media-upload.md para o passo a passo de cada provider.
# ==========================================================================================
OBJECT_STORAGE_ENABLED=false
# Vazio para AWS S3 real; preencha para R2/Spaces/MinIO (ex.: https://<account>.r2.cloudflarestorage.com).
OBJECT_STORAGE_ENDPOINT=
# R2 usa "auto"; Spaces usa a região do datacenter (ex.: "nyc3"); AWS usa a região real (ex.: "us-east-1").
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Domínio público (CDN/custom domain) na frente do bucket. Recomendado para R2 (bucket não tem
# URL pública própria sem isso) — sem ele, a URL é derivada do endpoint/bucket.
OBJECT_STORAGE_PUBLIC_BASE_URL=
# "true" (padrão) = path-style (.../bucket/key) — obrigatório pra R2/MinIO. DigitalOcean Spaces
# aceita os dois estilos; use "false" pra virtual-hosted style (bucket.regiao.digitaloceanspaces.com).
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Vazio por padrão (R2 não suporta ACL por objeto). Em S3/Spaces com Block Public Access desligado,
# use "public-read" para o objeto ficar acessível sem assinatura.
OBJECT_STORAGE_ACL=
# Limite por upload (bytes). 100MB cobre a maioria dos vídeos curtos de post.
MEDIA_UPLOAD_MAX_BYTES=100000000

# Loop em processo que dispara os posts agendados (runDueSchedules + worker).
# Desligue com "false" quando um scheduler externo/cron for responsável.
PUBLICATION_SCHEDULER_ENABLED=true
PUBLICATION_SCHEDULER_INTERVAL_MS=30000

# ==========================================================================================
# Scheduling / Calendario editorial (Sprint 21). Defaults seguros: janela limitada, lease curto
# e missed occurrence em revisão manual.
# ==========================================================================================
SCHEDULING_OCCURRENCE_WINDOW_DAYS=30
SCHEDULING_MAX_OCCURRENCES_PER_RUN=200
SCHEDULING_LEASE_MS=60000
SCHEDULING_MAX_BATCH=10
SCHEDULING_MISSED_GRACE_MS=900000
SCHEDULING_LATE_THRESHOLD_MS=900000
SCHEDULING_CONFLICT_WINDOW_MINUTES=30

# ==========================================================================================
# Analytics (Sprint 22). Apenas eventos internos/sandbox, sem analytics real de APIs externas.
# ==========================================================================================
ANALYTICS_MAX_QUERY_DAYS=370
ANALYTICS_DEFAULT_TIMEZONE=America/Sao_Paulo
ANALYTICS_EXPORT_RETENTION_DAYS=7
