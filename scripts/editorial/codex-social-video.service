[Unit]
Description=Vídeos (Reels) das pautas de vídeo do Bolsão com Codex — ramo de vídeo do piloto
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/vorix-editorial
# Trava própria: a espera pelo render (worker de vídeo, um por vez) não segura a trava das imagens 12h/19h.
ExecStart=/usr/bin/flock --nonblock /run/vorix-editorial-video.lock /usr/bin/node /opt/vorix-editorial/codex-social-video.mjs run
TimeoutStartSec=100min
InaccessiblePaths=/opt/zuno /root /var/lib/docker
