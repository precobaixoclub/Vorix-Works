[Unit]
Description=Refação das artes reprovadas no WhatsApp (Codex)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/vorix-editorial
ExecStart=/usr/bin/flock --nonblock /run/vorix-editorial.lock /usr/bin/node /opt/vorix-editorial/codex-social-redo.mjs
TimeoutStartSec=45min
InaccessiblePaths=/opt/zuno /root /var/lib/docker
