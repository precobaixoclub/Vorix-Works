# Variáveis para docker-compose.zuno.yml — copiar para `.env.zuno` NO SERVIDOR (nunca commitar
# esse arquivo com valores reais) e ajustar antes de subir.

# Gerar com: openssl rand -hex 32
ZUNO_JWT_SECRET=
ZUNO_POSTGRES_PASSWORD=

# Portas diretas no host (fallback/debug — livres no droplet no momento da investigação: 8090/8091).
ZUNO_API_PORT=8090
ZUNO_WEB_PORT=8091

# Domínio vorixworks.com, roteado via Traefik (labels no docker-compose.zuno.yml).
ZUNO_API_ORIGIN=https://api.vorixworks.com
ZUNO_WEB_ORIGIN=https://vorixworks.com

# true assim que houver HTTPS de verdade na frente (Traefik + Let's Encrypt) — nunca antes disso,
# ou o cookie de refresh nunca seria enviado pelo browser.
ZUNO_COOKIE_SECURE=true

# API e frontend vivem em subdomínios irmãos (api.vorixworks.com / vorixworks.com) — sem Domain
# explícito o cookie do refresh token é host-only (só api.vorixworks.com o vê) e o proxy.ts do
# frontend nunca o enxerga, derrubando o usuário de volta em /login mesmo com login bem-sucedido.
ZUNO_COOKIE_DOMAIN=.vorixworks.com

# Meta Login + Instagram/Facebook Content Publishing.
# Preencher no `.env.zuno` do servidor com os dados do app em developers.facebook.com.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_BASE_URL=https://graph.facebook.com/v21.0
META_INSTAGRAM_ENABLED=true
META_INSTAGRAM_OAUTH_REDIRECT_URI=https://vorixworks.com/instagram/callback
# Recomendado para Facebook Login for Business. Sem isso, o Zuno usa o parâmetro `scope`.
META_LOGIN_CONFIG_ID=

# TikTok Login Kit + Content Posting API.
# Preencher no `.env.zuno` do servidor com os dados do app em developers.tiktok.com.
TIKTOK_ENABLED=true
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=https://vorixworks.com/tiktok/callback
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_AUTHORIZE_BASE_URL=https://www.tiktok.com
# No Sandbox, se "Direct Post" estiver desligado, não pedir video.publish.
TIKTOK_SCOPES=user.info.basic,video.upload,user.info.profile,video.list
# Login Kit Web documenta OAuth sem PKCE. Ligar só para desktop/mobile.
TIKTOK_PKCE_ENABLED=false

# YouTube Shorts (Google Cloud OAuth + YouTube Data API v3).
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://vorixworks.com/youtube/callback
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_UPLOAD_BASE_URL=https://www.googleapis.com/upload/youtube/v3
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

# Libera publicação real para os providers sociais. Sem isso a governança mantém publicação externa
# bloqueada ou em dry_run, mesmo com OAuth conectado.
PUBLICATION_PROVIDER_ENVIRONMENT=production
PUBLICATION_PRODUCTION_ENABLED=true
PUBLICATION_CANARY_ENABLED=true
PUBLICATION_CANARY_PROVIDER_IDS=instagram,facebook,tiktok,youtube
PUBLICATION_CANARY_TENANT_IDS=*
PUBLICATION_CANARY_WORKSPACE_IDS=*
