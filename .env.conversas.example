# Variáveis para docker-compose.conversas-gateway.yml — copiar para `.env.conversas` NO SERVIDOR
# (nunca commitar esse arquivo com valores reais). Deploy independente de `.env.zuno`/
# docker-compose.zuno.yml — ver scripts/deploy-conversas-gateway.sh.
#
# WUZAPI_ADMIN_TOKEN precisa ter o MESMO valor configurado em `.env.zuno` (variável de mesmo nome)
# no stack do Vorix — é assim que zuno-api/vorix-worker se autenticam contra o WuzAPI.

# Gerar com: openssl rand -hex 32
WUZAPI_POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
WUZAPI_ADMIN_TOKEN=

# NUNCA gerar uma chave nova a cada deploy — trocar isto depois da primeira sessão pareada torna
# as sessões existentes ilegíveis (todas precisariam escanear o QR Code de novo). Gerar uma vez e
# manter fixo neste arquivo para sempre.
# ACHADO AO VIVO (spike Fase 2): o WuzAPI usa o valor LITERAL da string como bytes da chave AES —
# `openssl rand -hex 32` gera 64 caracteres e quebra com "invalid key size 64". Usar
# `openssl rand -hex 16` (32 caracteres = 32 bytes, AES-256) em vez de `-hex 32`.
WUZAPI_GLOBAL_ENCRYPTION_KEY=

RABBITMQ_USER=vorix

# Pin de versão explícito — nunca ":latest" em produção (evita quebra silenciosa num restart que
# puxa uma imagem nova sem aviso). Ajustar para uma tag de release real do projeto WuzAPI.
WUZAPI_IMAGE=asternic/wuzapi:latest

# Só usada com docker-compose.conversas-gateway.spike.yml (spike da Fase 2, nunca em produção) —
# senha do Postgres descartável do worker durante o spike, nunca o zuno-postgres real.
SPIKE_VORIX_POSTGRES_PASSWORD=
